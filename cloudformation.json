{
	"Description": "This template is used to deploy my portfolio in AWS ECS Fargate, Environment of the ECS Fargate service is in a private subnet that is in a private VPC, connection goes in and out through PrivateLink and ALB",
	"Resources": {
		"ALBSubnet": {
			"Type": "AWS::EC2::Subnet",
			"Properties": {
				"VpcId": {
					"Ref": "PrivateVPC"
				},
				"CidrBlock": "10.192.0.0/24",
				"AvailabilityZone": "ap-southeast-2a",
				"MapPublicIpOnLaunch": true,
				"Tags": [
					{
						"Key": "Name",
						"Value": "Ghazi-Portfolio-ALB-Subnet"
					}
				]
			}
		},
        "ALBSubnet2": {
			"Type": "AWS::EC2::Subnet",
			"Properties": {
				"VpcId": {
					"Ref": "PrivateVPC"
				},
				"CidrBlock": "10.192.2.0/24",
				"AvailabilityZone": "ap-southeast-2b",
				"MapPublicIpOnLaunch": true,
				"Tags": [
					{
						"Key": "Name",
						"Value": "Ghazi-Portfolio-ALB-Subnet2"
					}
				]
			}
		},
		"TargetGroup": {
			"Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
			"Properties": {
				"Name": "MyPortfolioTargetGroup",
				"Protocol": "HTTP",
				"Port": 3000,
				"TargetType": "ip",
				"VpcId": {
					"Ref": "PrivateVPC"
				}
			}
		},
		"ALBSecurityGroupForPublicInternet": {
			"Type": "AWS::EC2::SecurityGroup",
			"Properties": {
				"GroupDescription": "SG for ALB connecting to public internet",
				"VpcId": {
					"Ref": "PrivateVPC"
				}
			}
		},
		"ALBSecurityGroupForECS":{
			"Type":"AWS::EC2::SecurityGroup",
			"Properties":{
				"GroupDescription":"SG for ALB connecting with ECS Task inside a private subnet",
				"VpcId":{
					"Ref":"PrivateVPC"
				}
			}
		},
		"ECSServiceSecurityGroupForALB": {
			"Type": "AWS::EC2::SecurityGroup",
			"Properties": {
				"VpcId": {
					"Ref": "PrivateVPC"
				},
				"GroupDescription": "SG for ECS Service connecting with ALB to receive traffic from outside."
			},
			"DependsOn": "ALBSecurityGroupForECS"
		},
		"VPCEndpointSecurityGroup":{
			"Type":"AWS::EC2::SecurityGroup",
			"Properties":{
				"VpcId":{
					"Ref":"PrivateVPC"
				},
				"GroupDescription":"SG For VPC Endpoints - allows HTTPS traffic from ECS tasks"
			}
		},
		"ALBSecurityGroupIngressForPublicInternet": {
			"Type": "AWS::EC2::SecurityGroupIngress",
			"Properties": {
				"IpProtocol": "tcp",
				"FromPort": 80,
				"ToPort": 80,
				"CidrIp": "0.0.0.0/0",
				"GroupId":{"Ref":"ALBSecurityGroupForPublicInternet"}
			}
		},
		"ALBSecurityGroupIngressForPublicInternetHTTPS": {
			"Type": "AWS::EC2::SecurityGroupIngress",
			"Properties": {
				"IpProtocol": "tcp",
				"FromPort": 443,
				"ToPort": 443,
				"CidrIp": "0.0.0.0/0",
				"GroupId":{"Ref":"ALBSecurityGroupForPublicInternet"}
			}
		},
		"ALBSecurityGroupEgressForECSService":{
			"Type":"AWS::EC2::SecurityGroupEgress",
			"Properties":{
				"IpProtocol":"tcp",
				"FromPort":3000,
				"ToPort":3000,
				"DestinationSecurityGroupId":{
					"Ref":"ECSServiceSecurityGroupForALB"
				},
				"GroupId": {"Ref":"ALBSecurityGroupForECS"}
			}
		},
		"ECSServiceSecurityGroupIngressForALB": {
			"Type": "AWS::EC2::SecurityGroupIngress",
			"Properties": {
				"IpProtocol": "tcp",
				"FromPort": 3000,
				"ToPort": 3000,
				"SourceSecurityGroupId": {
					"Ref": "ALBSecurityGroupForECS"
				},
				"GroupId":{"Ref":"ECSServiceSecurityGroupForALB"}
			}
		},
		"ECSServiceSecurityGroupEgressForVPCEndpoints":{
			"Type":"AWS::EC2::SecurityGroupEgress",
			"Properties":{
				"IpProtocol":"tcp",
				"FromPort":443,
				"ToPort":443,
				"DestinationSecurityGroupId":{"Ref":"VPCEndpointSecurityGroup"},
				"GroupId": {"Ref":"ECSServiceSecurityGroupForALB"}
			}
		},
		"ECSServiceSecurityGroupEgressForS3PrefixList":{
			"Type":"AWS::EC2::SecurityGroupEgress",
			"Properties":{
				"IpProtocol":"tcp",
				"FromPort":443,
				"ToPort":443,
				"DestinationPrefixListId":"pl-6ca54005",
				"GroupId": {"Ref":"ECSServiceSecurityGroupForALB"}
			}
		},
		"VPCEndpointSecurityGroupIngressFromECS":{
			"Type":"AWS::EC2::SecurityGroupIngress",
			"Properties":{
				"IpProtocol":"tcp",
				"FromPort":443,
				"ToPort":443,
				"SourceSecurityGroupId":{"Ref":"ECSServiceSecurityGroupForALB"},
				"GroupId":{"Ref":"VPCEndpointSecurityGroup"}
			}
		},
		"PrivateVPC": {
			"Type": "AWS::EC2::VPC",
			"Properties": {
				"EnableDnsSupport": true,
				"EnableDnsHostnames": true,
				"CidrBlock": "10.192.0.0/16",
				"Tags": [
					{
						"Key": "Name",
						"Value": "Ghazi-Portfolio-Private-VPC"
					}
				]
			}
		},
		"PrivateSubnet": {
			"Type": "AWS::EC2::Subnet",
			"Properties": {
				"VpcId": {
					"Ref": "PrivateVPC"
				},
				"CidrBlock": "10.192.1.0/24",
				"AvailabilityZone": "ap-southeast-2a",
				"MapPublicIpOnLaunch": false,
				"Tags": [
					{
						"Key": "Name",
						"Value": "Ghazi-Portfolio-Private-Subnet"
					}
				]
			}
		},
		"ALB": {
			"Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
			"Properties": {
				"Name": "MyPortfolioALB",
				"Scheme": "internet-facing",
				"Subnets": [
					{
						"Ref": "ALBSubnet"
					},
                    {"Ref":"ALBSubnet2"}
				],
				"SecurityGroups": [
					{
						"Ref": "ALBSecurityGroupForECS"
					},
					{"Ref":"ALBSecurityGroupForPublicInternet"}
				]
			}
		},
        "ALBListener": {
			"Type": "AWS::ElasticLoadBalancingV2::Listener",
			"Properties": {
				"LoadBalancerArn": { "Ref": "ALB" },
				"Port": 80,
				"Protocol": "HTTP",
				"DefaultActions": [
					{
						"Type": "forward",
						"TargetGroupArn": { "Ref": "TargetGroup" }
					}
				]
			}
		},
		"VPCInternetGateway":{
			"Type" : "AWS::EC2::InternetGateway",
			"Properties" : {
				"Tags" : [ {"Key" : "stack", "Value" : "development"}]
			}
		},
		"AttachGateway":{
			"Type": "AWS::EC2::VPCGatewayAttachment",
			"Properties":{
				"VpcId": {"Ref": "PrivateVPC"},
				"InternetGatewayId": {"Ref": "VPCInternetGateway"}
			}
		},
		"PublicRouteTable":{
			"Type": "AWS::EC2::RouteTable",
			"Properties":{
				"VpcId": {"Ref": "PrivateVPC"}
			}
		},
		"PrivateSubnetRouteTable":{
			"Type":"AWS::EC2::RouteTable",
			"Properties":{
				"VpcId":{"Ref":"PrivateVPC"}
			}
		},
		"PrivateSubnetRouteTableAssociation":{
			"Type":"AWS::EC2::SubnetRouteTableAssociation",
			"Properties":{
				"SubnetId":{"Ref":"PrivateSubnet"},
				"RouteTableId":{"Ref":"PrivateSubnetRouteTable"}
			}
		},
		"PublicRoute":{
			"Type":"AWS::EC2::Route",
			"DependsOn":"AttachGateway",
			"Properties":{
				"RouteTableId":{"Ref":"PublicRouteTable"},
				"DestinationCidrBlock":"0.0.0.0/0",
				"GatewayId":{"Ref":"VPCInternetGateway"}
			}
		},
		"PublicALBSubnetRouteTableAssociation":{
			"Type": "AWS::EC2::SubnetRouteTableAssociation",
			"Properties":{
				"SubnetId": {"Ref":"ALBSubnet"},
				"RouteTableId": {"Ref":"PublicRouteTable"}
			}
		},
		"PublicALBSubnet2RouteTableAssociation":{
			"Type": "AWS::EC2::SubnetRouteTableAssociation",
			"Properties":{
				"SubnetId": {"Ref":"ALBSubnet2"},
				"RouteTableId": {"Ref":"PublicRouteTable"}
			}
		},
		"ECSPrivateLinkECRDkr":{
			"Type":"AWS::EC2::VPCEndpoint",
			"Properties":{
				"ServiceName":"com.amazonaws.ap-southeast-2.ecr.dkr",
				"VpcEndpointType":"Interface",
				"VpcId":{"Ref":"PrivateVPC"},
				"PrivateDnsEnabled":true,
				"SubnetIds":[
					{"Ref":"PrivateSubnet"}
				],
				"SecurityGroupIds":[
					{"Ref":"VPCEndpointSecurityGroup"}
				],
				"PolicyDocument":{
					"Statement":[
						{
							"Effect":"Allow",
							"Principal":"*",
							"Action":[
								"ecr:GetAuthorizationToken",
								"ecr:BatchCheckLayerAvailability",
								"ecr:GetDownloadUrlForLayer",
								"ecr:BatchGetImage"
							],
							"Resource":"*"
						}
					]
				}
			}
		},
		"ECSPrivateLinkECRApi":{
			"Type":"AWS::EC2::VPCEndpoint",
			"Properties":{
				"ServiceName":"com.amazonaws.ap-southeast-2.ecr.api",
				"VpcEndpointType":"Interface",
				"PrivateDnsEnabled":true,
				"VpcId":{"Ref":"PrivateVPC"},
				"SubnetIds":[
					{"Ref":"PrivateSubnet"}
				],
				"SecurityGroupIds":[
					{"Ref":"VPCEndpointSecurityGroup"}
				],
				"PolicyDocument":{
					"Statement":[
						{
							"Effect":"Allow",
							"Principal":"*",
							"Action":[
								"ecr:GetAuthorizationToken",
								"ecr:BatchCheckLayerAvailability",
								"ecr:GetDownloadUrlForLayer",
								"ecr:BatchGetImage"
							],
							"Resource":"*"
						}
					]
				}
			}
		},
		"CloudWatchLogsVPCEndpoint": {
			"Type": "AWS::EC2::VPCEndpoint",
			"Properties": {
				"ServiceName": "com.amazonaws.ap-southeast-2.logs",
				"VpcEndpointType": "Interface",
				"VpcId": {"Ref": "PrivateVPC"},
				"PrivateDnsEnabled": true,
				"SubnetIds": [
					{"Ref": "PrivateSubnet"}
				],
				"SecurityGroupIds": [
					{"Ref": "VPCEndpointSecurityGroup"}
				],
				"PolicyDocument":{
					"Statement":[
						{
							"Effect":"Allow",
							"Principal":"*",
							"Action":[
								"logs:CreateLogGroup",
								"logs:CreateLogStream",
								"logs:PutLogEvents",
								"logs:DescribeLogStreams"
							],
							"Resource":"*"
						}
					]
				}
			}
		},
		"PrivateLinkForS3ImageLayers":{
			"Type":"AWS::EC2::VPCEndpoint",
			"Properties":{
				"VpcEndpointType":"Gateway",
				"VpcId":{"Ref":"PrivateVPC"},
				"ServiceName":"com.amazonaws.ap-southeast-2.s3",
				"RouteTableIds":[
					{"Ref":"PrivateSubnetRouteTable"}
				],
				"PolicyDocument":{
					"Statement":[
						{
							"Effect":"Allow",
							"Principal":"*",
							"Action":[
								"s3:GetObject",
								"s3:PutObject"
							],
							"Resource":[
								"arn:aws:s3:::prod-ap-southeast-2-starport-layer-bucket/*"
							]
						}
					]
				}
			}
		},
		"ECSFargateCluster": {
			"Type": "AWS::ECS::Cluster",
			"Properties": {
				"CapacityProviders": [
					"FARGATE"
				],
				"ClusterName": "PortfolioCluster",
				"DefaultCapacityProviderStrategy": [
					{
						"CapacityProvider": "FARGATE",
						"Weight": 1
					}
				]
			}
		},
		"ECSTaskDefinition": {
			"Type": "AWS::ECS::TaskDefinition",
			"Properties": {
				"ContainerDefinitions": [
					{
						"Name": "MyPortfolioContainer",
						"Image": "461634832812.dkr.ecr.ap-southeast-2.amazonaws.com/myportfolio:latest",
						"PortMappings": [
							{
								"ContainerPort": 3000
							}
						],
						"Environment": [
							{
								"Name": "PROD",
								"Value": "1"
							}
						],
						"LogConfiguration": {
							"LogDriver": "awslogs",
							"Options": {
								"mode": "non-blocking",
								"max-buffer-size": "25m",
								"awslogs-group": "ecslogs",
								"awslogs-region": "ap-southeast-2",
								"awslogs-create-group": "true",
								"awslogs-stream-prefix": "ecslogstreamprefix"
							}
						}
					}
				],
				"Cpu": "256",
				"Memory": "512",
				"NetworkMode": "awsvpc",
                "RequiresCompatibilities":[
                  "FARGATE"
                ],
                "ExecutionRoleArn":"arn:aws:iam::461634832812:role/BetterECSTaskExecutionRole"
			}
		},
		"ECSService": {
			"Type": "AWS::ECS::Service",
			"Properties": {
				"Cluster": {
					"Ref": "ECSFargateCluster"
				},
				"CapacityProviderStrategy": [
					{
						"CapacityProvider": "FARGATE",
						"Weight": 1
					}
				],
				"DesiredCount": 1,
				"TaskDefinition": {
					"Ref": "ECSTaskDefinition"
				},
				"LoadBalancers": [
					{
						"ContainerName": "MyPortfolioContainer",
						"ContainerPort": 3000,
						"TargetGroupArn": { "Ref": "TargetGroup" }
					}
				],
				"ServiceName": "MyPortfolioService",
				"NetworkConfiguration": {
					"AwsvpcConfiguration": {
						"AssignPublicIp": "DISABLED",
						"Subnets": [
							{
								"Ref": "PrivateSubnet"
							}
						],
						"SecurityGroups": [
							{
								"Ref": "ECSServiceSecurityGroupForALB"
							}
						]
					}
				}
			},
			"DependsOn": ["ALB", "ECSPrivateLinkECRDkr", "ECSPrivateLinkECRApi", "CloudWatchLogsVPCEndpoint", "PrivateLinkForS3ImageLayers", "ECSServiceSecurityGroupEgressForS3PrefixList"]
		}
	}
}